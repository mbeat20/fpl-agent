# Postgres connection (Supabase project, ADR-0011: Postgres connection only —
# never the Supabase client SDK / Auth / Storage / Realtime).
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Required for the Claude-backed Reasoning implementation and for the
# `integration` test suite (pytest -m integration).
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Which Reasoning implementation the API wires up by default.
# "claude" (default) | "fake" (deterministic, no network — useful for local smoke-testing)
REASONING_IMPL=claude

# Your numeric FPL team (entry) id — from the URL when viewing your team on
# fantasy.premierleague.com, e.g. .../entry/1234567/event/1. Required to run
# `uv run fpl-ingest` (issue 03).
FPL_ENTRY_ID=

# ADR-0010: path to the flat-text Preferences file, loaded in full into every
# Reasoning call's system prompt. Defaults to backend/preferences.md if unset.
PREFERENCES_PATH=

# Understat season to pull xG/xA from, e.g. "2025" for the 2025/26 season
# (issue 05). Optional — auto-derived from the FPL season if unset, with an
# automatic one-year-back fallback if that season has no data yet.
UNDERSTAT_SEASON=

# xAI Live Search API key — ingests trusted creators' X posts (issue 06).
XAI_API_KEY=

# Voyage AI key — embeds creator content into pgvector (issue 06, ADR-0005).
VOYAGE_API_KEY=
